# ============================================================
# Datos, salidas y secretos: nunca en git (reglas no negociables 1 y 2)
# ============================================================
data/
outputs/
logs/
.env
.env.*
!.env.example

# Formatos de datos en cualquier carpeta: defensa ante exportes sueltos
# desde notebooks o scripts. Un resultado se comparte a propósito, nunca por accidente.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.pkl
*.pickle
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.gz
*.zip
*.log
*.json
!tests/fixtures/**/*.json
!.vscode/*.json

# Video y material pesado: se arma y se aloja fuera del repo
*.mp4
*.mov

# Documentos personales de la entrega (cartas firmadas, credenciales para votar,
# estados de cuenta): el repositorio es público
cartas/
**/*carta*firmad*

# ============================================================
# Python y entorno
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ============================================================
# Sistema operativo y editores
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
